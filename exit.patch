+// top-1 / top-2 logit gap as confidence metric
+static float logits_top_gap(const float * logits, int n_vocab) {
+    float max1 = -INFINITY;
+    float max2 = -INFINITY;
+    for (int i = 0; i < n_vocab; ++i) {
+        const float v = logits[i];
+        if (v > max1) {
+            max2 = max1;
+            max1 = v;
+        } else if (v > max2) {
+            max2 = v;
+        }
+    }
+    return max1 - max2;
+}
