-        case SERVER_TASK_TYPE_RERANK:
-            return true;
-        default:
-            return false;
+    return task_type == SERVER_TASK_TYPE_EMBEDDING || task_type == SERVER_TASK_TYPE_INFILL;
+}
+
+static float get_entropy_stability(const float * logits, int n_vocab) {
+    float max1 = -INFINITY;
+    float max2 = -INFINITY;
+    for (int i = 0; i < n_vocab; ++i) {
+        const float v = logits[i];
+        if (v > max1) {
+            max2 = max1;
+            max1 = v;
+        } else if (v > max2) {
+            max2 = v;
+        }
     }
+    return max1 - max2;
 }
 
