Subject: [PATCH 1/3] implementing early exit (function, constrains, accecs)

---
 common/arg.cpp                  | 21 ++++++++++++++
 common/common.h                 |  3 ++
 tools/completion/completion.cpp | 51 +++++++++++++++++++++++++++++++++
 tools/server/server-context.cpp | 10 +++++++
 4 files changed, 85 insertions(+)

diff --git a/common/arg.cpp b/common/arg.cpp
index e7966d9d5..fa2a1d472 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -1704,6 +1704,27 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             }
         }
     ).set_sparam());
+    add_opt(common_arg(
+        {"--early-exit"},
+        "stop generation based on information dynamics (S-threshold)",
+        [](common_params & params) {
+            params.sampling.early_exit = true;
+        }
+    ).set_sparam());
+    add_opt(common_arg(
+        {"--early-exit-gap"}, "N",
+        string_format("stability threshold (S) (default: %.1f)", (double)params.sampling.early_exit_gap),
+        [](common_params & params, const std::string & value) {
+            params.sampling.early_exit_gap = std::stof(value);
+        }
+    ).set_sparam());
+    add_opt(common_arg(
+        {"--early-exit-burnout"}, "N",
+        string_format("energy dissipation limit (E) (default: %.1f)", (double)params.sampling.early_exit_burnout),
+        [](common_params & params, const std::string & value) {
+            params.sampling.early_exit_burnout = std::stof(value);
+        }
+    ).set_sparam());
     add_opt(common_arg(
         {"--grammar"}, "GRAMMAR",
         string_format("BNF-like grammar to constrain generations (see samples in grammars/ dir) (default: '%s')", params.sampling.grammar.c_str()),
diff --git a/common/common.h b/common/common.h
index d6fd0d37a..8ec3a2266 100644
--- a/common/common.h
+++ b/common/common.h
@@ -189,9 +189,12 @@ struct common_params_sampling {
     float   top_n_sigma        = -1.00f;// -1.0 = disabled
     float   mirostat_tau       = 5.00f; // target entropy
     float   mirostat_eta       = 0.10f; // learning rate
+    float   early_exit_gap     = 6.0f;    // Stability threshold (S)
+    float   early_exit_burnout = 1000.0f; // Energy dissipation limit (E)
     bool    ignore_eos         = false;
     bool    no_perf            = false; // disable performance metrics
     bool    timing_per_token   = false;
+    bool    early_exit         = false; // disable early exit
 
     uint64_t user_sampling_config = 0; // bitfield to track user-specified samplers
 
diff --git a/tools/completion/completion.cpp b/tools/completion/completion.cpp
index a9eda119d..ee6f68002 100644
--- a/tools/completion/completion.cpp
+++ b/tools/completion/completion.cpp
@@ -41,6 +41,22 @@ static std::vector<llama_token> * g_output_tokens;
 static bool is_interacting  = false;
 static bool need_insert_eot = false;
 
+// calculate local_entropy_stability (S) via logit gap
+static float get_entropy_stability(const float * logits, int n_vocab) {
+    float max1 = -INFINITY;
+    float max2 = -INFINITY;
+    for (int i = 0; i < n_vocab; ++i) {
+        const float v = logits[i];
+        if (v > max1) {
+            max2 = max1;
+            max1 = v;
+        } else if (v > max2) {
+            max2 = v;
+        }
+    }
+    return max1 - max2;
+}
+
 static void print_usage(int argc, char ** argv) {
     (void) argc;
 
@@ -521,6 +537,7 @@ int main(int argc, char ** argv) {
         is_interacting = params.interactive_first;
     }
 
+    bool dynamics_initialized = false;
     bool is_antiprompt        = false;
     bool input_echo           = true;
     bool display              = true;
@@ -531,6 +548,10 @@ int main(int argc, char ** argv) {
     int n_consumed         = 0;
     int n_session_consumed = 0;
 
+    // Information Dynamics Tracking
+    float s_prev_stability = 0.0f;
+    float e_accumulated_dissipation = 0.0f;
+
     std::vector<int>   input_tokens;  g_input_tokens  = &input_tokens;
     std::vector<int>   output_tokens; g_output_tokens = &output_tokens;
     std::ostringstream output_ss;     g_output_ss     = &output_ss;
@@ -707,6 +728,36 @@ int main(int argc, char ** argv) {
                 LOG_DBG("saved session to %s\n", path_session.c_str());
             }
 
+            // ---- Information Dynamics Control ----
+            if (params.sampling.early_exit) {
+                const float * logits = llama_get_logits(ctx);
+                const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+                const float S = get_entropy_stability(logits, n_vocab);
+
+                if (!dynamics_initialized) {
+                    s_prev_stability = S;
+                    dynamics_initialized = true;
+                }
+
+                float S_prime = S - s_prev_stability; 
+                s_prev_stability = S;
+                e_accumulated_dissipation += std::abs(S_prime);
+
+                LOG_INF("[Dynamics] S: %.3f | dS: %.3f | E: %.2f\n", S, S_prime, e_accumulated_dissipation);
+
+                // Energy-based Burnout Exit
+                if (e_accumulated_dissipation > params.sampling.early_exit_burnout) {
+                    LOG_INF("[Dynamics] E-limit reached (%.1f). Exit.\n", e_accumulated_dissipation);
+                    break;
+                }
+
+                // Convergence Exit
+                if (S > params.sampling.early_exit_gap) {
+                    LOG_INF("[Dynamics] S-convergence (%.2f). Exit.\n", S);
+                    break;
+                }
+            }
+
             const llama_token id = common_sampler_sample(smpl, ctx, -1);
 
             common_sampler_accept(smpl, id, /* accept_grammar= */ true);
diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 33635a158..4a5afca6a 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -109,6 +109,11 @@ struct server_slot {
 
     std::vector<completion_token_output> generated_token_probs;
 
+    // Information Dynamics Slot-State
+    float s_prev_stability = 0.0f;
+    float e_accumulated_dissipation = 0.0f;
+    bool  dynamics_initialized = false;
+
     bool has_next_token = true;
     bool has_new_line   = false;
     bool truncated      = false;
@@ -199,6 +204,11 @@ struct server_slot {
         task.reset();
         task_prev.reset();
 
+        // Reset dynamics
+        s_prev_stability = 0.0f;
+        e_accumulated_dissipation = 0.0f;
+        dynamics_initialized = false;
+
         // clear alora start
         alora_invocation_start = -1;
     }
